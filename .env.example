# 이 파일을 복사해 .env 로 만든 뒤 값을 채워주세요.  (cp .env.example .env)
SECRET_KEY=change-me
DEBUG=True

DB_ENGINE=django.db.backends.mysql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# 필수. 구글 클라우드 콘솔 → API 및 서비스 → 사용자 인증 정보의 웹 클라이언트 ID (프론트엔드와 같은 값)
# 비어 있으면 서버가 켜지지 않습니다.
GOOGLE_CLIENT_ID=

# AI 서버 (FastAPI)
AI_SERVER_URL=http://127.0.0.1:8001
AI_SERVER_TOKEN=
# 학습 자료 업로드 (기본값: 20MB, 프로젝트 폴더의 tmp_uploads, soffice)
# MAX_UPLOAD_MB=20
# TEMP_UPLOAD_DIR=C:/line1/tmp_uploads
# LIBREOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.exe
