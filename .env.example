# 이 파일을 복사해 .env 로 만든 뒤 값을 채워주세요.  (cp .env.example .env)
SECRET_KEY=change-me
DEBUG=True
# 로그의 env 값. 기본은 DEBUG=True면 local, False면 prod
# APP_ENV=local
# API 문서(/api/docs). 기본은 DEBUG와 같습니다. 운영에서는 켜지 않습니다.
# API_DOCS=True

DB_ENGINE=django.db.backends.mysql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# 필수. 구글 클라우드 콘솔 → API 및 서비스 → 사용자 인증 정보의 웹 클라이언트 ID (프론트엔드와 같은 값)
# 비어 있으면 서버가 켜지지 않습니다.
GOOGLE_CLIENT_ID=

# 브라우저에서 API를 부르는 프론트엔드 주소. 쉼표로 구분 (끝에 / 없이)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI 서버 (FastAPI)
AI_SERVER_URL=http://127.0.0.1:8001
AI_SERVER_TOKEN=
# 학습 자료 업로드 (기본값: 20MB, 프로젝트 폴더의 tmp_uploads, soffice)
# MAX_UPLOAD_MB=20
# MAX_IMAGE_MB=5
# TEMP_UPLOAD_DIR=C:/line1/tmp_uploads
# LIBREOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.exe
# 시험 문제 수 (기본값: 학생 AI 평가 5, 재시험 3)
# EVALUATION_QUESTION_COUNT=5
# RETEST_QUESTION_COUNT=3

# 운영 DB 클라이언트 인증서 접속. 로컬에서는 비워 둡니다. 셋 중 하나만 채우면 서버가 켜지지 않습니다.
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=
